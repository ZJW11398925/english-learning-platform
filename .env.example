# 需要哪些密钥（本文件入库；真实值放 .env，绝不提交）

# DeepSeek API —— 视觉与文本共用同一模型（V4.1-Flash 原生多模态）
# 注意：模型 ID 是 deepseek-flash。legacy 名 deepseek-v4-flash /
# deepseek-v4-flash-vision-exp 已退役但仍被接受，会转到 V4.1-Flash。
# deepseek-v4-pro 不支持 Vision，不要用它做识物。
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 识物用图像细节档：low 会缩到 512x512，与设计文档 §4.6 的 512px 长边一致
VISION_DETAIL=low

# 本地开发用：内网穿透拿到的 HTTPS 域名会动态变化（getUserMedia 需要安全上下文）
PUBLIC_BASE_URL=

# 服务端口
PORT=8787
